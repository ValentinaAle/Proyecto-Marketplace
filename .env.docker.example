# Valores para la ejecución local con Docker Compose.
# Copiar a .env.docker y usar --env-file .env.docker en los comandos.
FRONTEND_PORT=8080
DOCKER_DB_NAME=marketplace_db
DOCKER_DB_USER=fivox
DOCKER_DB_PASSWORD=fivox_local
DOCKER_DB_ROOT_PASSWORD=root_local
DOCKER_JWT_SECRET=fivox-secreto-solo-para-desarrollo-local

# Opcional: necesario para enviar correos de recuperación de contraseña.
EMAIL_USER=
EMAIL_PASS=
